package-as: Shatter

# Shatter's one embedded library is LibGlass-1.0 (#14); a nolib zip without it
# would render flat, which nobody needs a separate download for.
enable-nolib-creation: no

# LibGlass-1.0, the glass material shared by the Glass addons, pinned to a
# release tag. Never committed (.gitignore): the packager fetches it, and
# Tools/deploy.ps1 copies the ../LibGlass checkout for a dev build.
externals:
  Libs/LibGlass-1.0:
    url: https://github.com/Spotnick2/LibGlass
    tag: r5

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# A YAML list, not markdown bullets: a `*` here silently ignores nothing.
# Comments on their own lines only - the packager's YAML reader keeps an inline
# "# ..." as part of the value.
# CHANGELOG.md is here AND in manual-changelog on purpose: the packager reads it
# for the release notes, and this keeps the file itself out of the addon.
# LICENSE deliberately ships: the notice travels with the distribution.
ignore:
  - .github
  - .claude
  - docs
  - tests
  - Tools
  - AGENTS.md
  - CLAUDE.md
  - SPEC.md
  - README.md
  - CHANGELOG.md
  # The packager does not apply an external's own ignore list: LibGlass's
  # non-dot entries, repeated. Its LICENSE ships.
  - Libs/LibGlass-1.0/tests
  - Libs/LibGlass-1.0/docs
  - Libs/LibGlass-1.0/Tools
  - Libs/LibGlass-1.0/AGENTS.md
  - Libs/LibGlass-1.0/CLAUDE.md
  - Libs/LibGlass-1.0/README.md
